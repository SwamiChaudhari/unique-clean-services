6:T492,{"@context":"https://schema.org","@type":"LocalBusiness","name":"UNIQUE CLEAN SERVICES","description":"Maharashtra's trusted cleaning & facility management company serving homes, offices, industries, hospitals, schools, hotels, and housing societies across Nashik & Pune. Background-verified staff, eco-friendly chemicals, ISO-aligned processes, and 24/7 support.","image":"https://unique-clean-services.vercel.app/og-image.jpg","telephone":"+91096234 44499","email":"hello@uniquecleanservices.in","url":"https://unique-clean-services.vercel.app","address":{"@type":"PostalAddress","streetAddress":"N-53, AJ/1, 4/1, Ambad - Uttam Nagar Road","addressLocality":"CIDCO","addressRegion":"Maharashtra","postalCode":"422010","addressCountry":"IN"},"geo":{"@type":"GeoCoordinates","latitude":"19.9975","longitude":"73.7898"},"openingHours":"Mo-Su 00:00-23:59","priceRange":"₹₹","aggregateRating":{"@type":"AggregateRating","ratingValue":"4.4","reviewCount":"152","bestRating":"5"},"sameAs":["https://facebook.com/uniquecleanservices","https://instagram.com/uniquecleanservices","https://twitter.com/uniquecleanservices","https://linkedin.com/company/uniquecleanservices"]}0:{"P":null,"c":["","commercial"],"q":"","i":false,"f":[[["",{"children":["commercial",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",20],[["$","$L1",null,{"loading":[["$","div","l",{"className":"min-h-screen bg-white","children":[["$","div",null,{"className":"h-16 bg-surface border-b border-border animate-pulse"}],["$","div",null,{"className":"py-16 lg:py-24 px-4","children":["$","div",null,{"className":"max-w-7xl mx-auto","children":["$","div",null,{"className":"grid lg:grid-cols-2 gap-10","children":[["$","div",null,{"className":"space-y-4","children":[["$","div",null,{"className":"h-6 w-32 bg-surface rounded-full animate-pulse"}],["$","div",null,{"className":"h-12 w-full bg-surface rounded-xl animate-pulse"}],["$","div",null,{"className":"h-12 w-3/4 bg-surface rounded-xl animate-pulse"}],["$","div",nul